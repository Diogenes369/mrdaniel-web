{
  "name": "mrdaniel-mcp-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Local MCP server + 24/7 background worker for mrdaniel.co.il ops. Standalone like whatsapp-server/ — never deployed to Vercel.",
  "scripts": {
    "mcp": "node src/server.js",
    "agent": "node start-agent.js",
    "agent:once": "node start-agent.js --once",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:stop": "pm2 stop mrdaniel-agent",
    "pm2:logs": "pm2 logs mrdaniel-agent",
    "selftest": "node src/selftest.js",
    "figma:bridge": "node start-bridge.js",
    "test:bridge": "node src/figma-bridge.selftest.js",
    "test:copy": "node src/copy-rules.selftest.js",
    "pm2:restart": "pm2 startOrReload ecosystem.config.cjs --update-env && pm2 save",
    "pm2:save": "pm2 save",
    "pm2:status": "pm2 status mrdaniel-agent"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "dotenv": "^17.4.2",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.4.0",
    "ws": "^8.21.3",
    "zod": "^4.6.5"
  }
}
