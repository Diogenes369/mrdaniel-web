# mcp-server/.env — local overrides only. Everything below is optional:
# VITE_FIREBASE_* are read from the repo root .env and VITE_ADMIN_API_SECRET from dashboard/.env.

# Service account JSON (raw or base64) or a path to the file. Without it, `leads` is unreadable
# (the path is locked to admins) and everything else goes through the anonymous web client.
# FIREBASE_SERVICE_ACCOUNT=
# FIREBASE_SERVICE_ACCOUNT_PATH=C:\secrets\mrdaniel-firebase-sa.json

# ADMIN_API_SECRET=            # overrides dashboard/.env's VITE_ADMIN_API_SECRET
# SITE_ORIGIN=https://mrdaniel.co.il
# DASHBOARD_URL=https://dashboard-snowy-psi-94.vercel.app
# MCP_WORKSPACE_ROOT=C:\Projects\My Website

# Worker schedule
# AGENT_HEALTH_EVERY_MIN=15
# AGENT_METRICS_EVERY_MIN=360
# AGENT_DRAFT_HOUR=9           # Asia/Jerusalem; -1 disables the daily draft
# AGENT_DRAFT_PLATFORM=linkedin
# AGENT_NOTIFY_WEBHOOK=        # receives POST { "text": "..." } on health changes / stale leads
