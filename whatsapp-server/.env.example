# Port this bridge's HTTP API listens on (both /send and the outbound forwarder use this process).
PORT=4000

# Must match ADMIN_API_SECRET's sibling on the main site — actually, no: this must match
# WHATSAPP_WEBHOOK_SECRET on the main site's Vercel project exactly. Used both ways: sent as
# x-webhook-secret when this bridge forwards an incoming message to the main site, and required as
# x-bridge-secret on every POST /send call the main site makes back to this bridge.
WHATSAPP_WEBHOOK_SECRET=

# The main site's webhook endpoint that receives forwarded incoming WhatsApp messages.
MAIN_SITE_WEBHOOK_URL=https://mrdaniel.co.il/api/agent-whatsapp-webhook

# Only messages FROM this number are processed/forwarded — digits only, country code, no + or
# spaces. Everyone else's messages to this WhatsApp number are silently ignored.
ADMIN_WHATSAPP_NUMBER=972506473039
