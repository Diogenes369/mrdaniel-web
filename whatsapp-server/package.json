{
  "name": "whatsapp-bridge",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Self-hosted WhatsApp bridge (Baileys) for the Social Agent's approval workflow. Not part of the main site's npm workspace — a fully standalone service you run yourself, 24/7, on a machine you control.",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:stop": "pm2 stop whatsapp-bridge",
    "pm2:logs": "pm2 logs whatsapp-bridge"
  },
  "dependencies": {
    "@hapi/boom": "^10.0.1",
    "@whiskeysockets/baileys": "^6.7.9",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "libsignal": "^6.0.0",
    "pino": "^9.5.0",
    "qrcode": "^1.5.4"
  },
  "overrides": {
    "libsignal": "^6.0.0"
  }
}
