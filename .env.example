# ==============================================================================
# MR. DANIEL — Environment Variables
# Copy this file to `.env.local` for local dev, and add the same keys/values to your Vercel
# project's Environment Variables (Project Settings → Environment Variables) for production.
# VITE_-prefixed keys are inlined into the public browser bundle — never put a real secret there.
# ==============================================================================


# --- Firebase (Realtime Database + Auth) -------------------------------------------------------
# From your Firebase project's web app config (Firebase Console → Project Settings → General →
# Your apps → SDK setup and configuration). These 7 are already required by the existing tracker/
# lead-capture/newsletter features — the Social Agent module below reuses this same project.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# IMPORTANT — Firebase Realtime Database rule you must add yourself (Firebase Console → Realtime
# Database → Rules): the Social Agent needs read/write on these paths, the same way `leads` already
# needed its own rule added by hand. Example (adjust to match your existing rules structure):
#   "agent_config": { ".read": true, ".write": true },
#   "agent_queue":  { ".read": true, ".write": true },
#   "weekly_plan":  { ".read": true, ".write": true },
#   "video_jobs":   { ".read": true, ".write": true }


# --- AI content generation (Google Gemini) ------------------------------------------------------
# Already required by the existing AI chat widget (api/chat.ts) — the Social Agent's content
# generation, lead-intent scoring, and engagement drafting reuse this exact same key server-side.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Groq — PRIMARY engine for TEXT-only generation (decks, posts, summaries). Free tier, and far
# less rate-limited than Gemini. See src/agent/groqClient.ts. Optional: with no key set, every
# text call simply stays on Gemini.
# Model override (default openai/gpt-oss-120b): GROQ_MODEL=
GROQ_API_KEY=

# xAI / Grok — the dashboard's Grok agent (X-optimized carousels + threads, action `grok-carousel`)
# and the fallback source for the homepage's live X feed (`/api/news?action=x-feed`).
# NOTE: an X Premium subscription does NOT include API access — create a key and load credit at
# https://console.x.ai. With no key set, the Grok tab falls back to the local deck + thread builder
# and the X feed shows its last snapshot / a follow card.
# Vercel: npx vercel env add XAI_API_KEY production   (then again for preview)
XAI_API_KEY=
# Model override (default grok-4.7): XAI_MODEL=
# How long the X feed is cached, in minutes (default 120). x_search is billed per post fetched.
# X_FEED_TTL_MIN=


# --- Lead email delivery (SMTP) -------------------------------------------------------------------
# Required for the contact/lead form to actually send an email. Gmail example: use an App Password
# (Google Account → Security → 2-Step Verification → App Passwords), not your real password.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
# Optional — defaults to danihell3039@gmail.com if unset.
LEAD_EMAIL_TO=


# --- ManyChat Comment-to-DM leads (api/leads.ts, action 'manychat-lead') ---------------------------
# MANYCHAT_WEBHOOK_SECRET — any long random string. ManyChat's External Request sends it as the
# `x-manychat-secret` header (or `Authorization: Bearer <secret>`). Unlike ADMIN_API_SECRET this
# fails CLOSED: while unset, the action answers 503 and stores nothing — it writes to the same
# `leads` list that email campaigns read, so an open endpoint would let anyone fill that list.
MANYCHAT_WEBHOOK_SECRET=


# --- Social Agent module (src/agent/) -------------------------------------------------------------
# Both variables below are NEW as of this module and are OPTIONAL but strongly recommended:
# /api/agent-generate calls Gemini (a metered, billable API) on every content-generation and
# engagement-drafting request, so leaving it fully open lets anyone who finds the URL spend your
# Gemini quota. Set ADMIN_API_SECRET to close that off.
#
# ADMIN_API_SECRET — any long random string you choose. Required as the `x-admin-secret` header on
# every POST to /api/agent-generate once set (score-lead / generate-content / draft-engagement).
# If left unset, the endpoint stays open (fails open, not closed) so a fresh checkout isn't
# hard-blocked before you've had a chance to set one — set this before relying on the feature.
ADMIN_API_SECRET=

# CRON_SECRET — any long random string you choose (same as ADMIN_API_SECRET). Once this env var
# exists, Vercel automatically attaches `Authorization: Bearer <this value>` to its own Cron Job
# invocations (vercel.json already schedules one, hitting /api/agent-generate daily at 08:00 UTC
# for the "Auto-Pilot" autonomous cycle) — that's how /api/agent-generate's GET branch verifies a
# request genuinely came from Vercel's scheduler and not a public GET to that same URL. If unset,
# the cron endpoint accepts any GET (fails open, same reasoning as ADMIN_API_SECRET above).
CRON_SECRET=

# NOTE — scope of "autonomous": Auto-Pilot mode generates content DRAFTS into an admin-reviewed
# queue on a schedule. There is no live LinkedIn/Instagram posting integration in this codebase —
# actually publishing to those platforms requires registering an app with each platform, going
# through their developer/business review process, and OAuth-connecting a real account, none of
# which is something that can be safely or completely wired up without your own platform
# credentials and explicit sign-off (both platforms' Terms of Service also restrict automated
# posting/outreach, so "fully autonomous live posting" is a deliberate scope boundary, not a gap).
# If you want that added later, the integration point is generateSocialContent() in
# src/agent/SocialAgentEngine.ts.


# --- Self-hosted WhatsApp bridge (whatsapp-server/ & api/agent-whatsapp-webhook.ts) --------------
# ⚠️ whatsapp-server/ uses Baileys, an UNOFFICIAL WhatsApp client — not Meta's official Business
# API. This is a real Terms-of-Service and account-ban risk, not boilerplate legalese. See
# whatsapp-server/README.md's warning before running it against a real/primary number — use a
# dedicated secondary number if you proceed.
#
# WHATSAPP_WEBHOOK_SECRET — required in BOTH directions: the bridge sends it as `x-webhook-secret`
# when forwarding an incoming message here, and this site sends it as `x-bridge-secret` when
# calling the bridge's POST /send. Must be the exact same value as whatsapp-server/.env's copy.
# If left unset, both sides fail open (same reasoning as ADMIN_API_SECRET above).
WHATSAPP_WEBHOOK_SECRET=

# WHATSAPP_BRIDGE_URL — the bridge's public /send URL once you've deployed whatsapp-server/
# somewhere reachable from Vercel (a VPS with a domain, or a tunnel like ngrok/Cloudflare Tunnel
# for a machine with no public IP — see whatsapp-server/README.md). Leave empty until then; the
# WhatsApp notification path simply stays inactive (the generic Webhook Settings fields in the
# dashboard's Agent tab still work independently of this).
WHATSAPP_BRIDGE_URL=

# Optional — defaults to 972506473039 (the site's existing sanctioned WhatsApp number) if unset.
ADMIN_WHATSAPP_NUMBER=


# --- AI video generation (src/agent/VideoGenerationEngine.ts, api/generate-video.ts) --------------
# Turns a generated VideoScript (Hook/scenes/CTA/Visual Cues) into an actual rendered .mp4 — the
# "צור וידאו AI" button in the dashboard's Weekly Plan and Agent tabs. The dashboard's model dropdown
# lets you pick a specific provider per generation; if none is picked, the engine falls back through
# whichever of these are configured in this order (Veo first). Every provider below is independently
# optional — the request only errors out (naming the exact missing keys, printed to the server
# console) if the specifically-chosen provider (or, with no selection, all of them) isn't configured.
#
# 1) Google Veo — reuses GEMINI_API_KEY above, no separate key needed. IMPORTANT: standard Gemini
#    API access does NOT automatically include Veo — video generation must be separately enabled on
#    your Google AI Studio / Cloud project (it's a different, paid, allowlisted capability). If Veo
#    calls fail with a permission/access error, that's this account-level gate, not a bug — see
#    https://ai.google.dev/gemini-api/docs/video.
# Optional — overrides the Veo model id if you have access to a different one than the default.
VEO_MODEL_ID=

# 2) Runway ML (Cinematic 9:16 scenes) — https://dev.runwayml.com for an API key.
RUNWAY_API_KEY=

# 3) HeyGen (avatar talking-head, reads the Hook+Body as speech) —
#    https://app.heygen.com/settings?nav=API. Avatar-based, so it additionally needs an avatar and a
#    voice id from your HeyGen account, not just the API key.
HEYGEN_API_KEY=
HEYGEN_AVATAR_ID=
HEYGEN_VOICE_ID=

# 4) Replicate (fast Wan/LTX-Video B-roll from Visual Cues) — https://replicate.com/account/api-tokens
#    for the token. REPLICATE_MODEL selects which published model to run (owner/model slug, no
#    version pin needed — always runs that model's latest version); defaults to a Wan 2.1
#    text-to-video model. Set to `lightricks/ltx-video` to use LTX-Video instead, or browse
#    https://replicate.com/explore for other current text-to-video models. REPLICATE_MODEL_VERSION
#    is optional and, if set, pins an exact version hash instead (takes priority over
#    REPLICATE_MODEL when both are set).
REPLICATE_API_TOKEN=
REPLICATE_MODEL=
REPLICATE_MODEL_VERSION=

# 5) KlingAI (realistic motion/scene generation) — https://klingai.com developer console.
#    Kling's officially documented API authenticates with a short-lived JWT signed from an Access
#    Key ID + Secret Key pair, not a single static token — set KLING_ACCESS_KEY + KLING_SECRET_KEY
#    for that flow. KLING_API_KEY alone is used as a direct Bearer token fallback, which only works
#    if that string is itself a pre-issued token from the Kling console; if Kling rejects it, the
#    resulting error surfaces honestly in the video job rather than a fake success.
KLING_API_KEY=
KLING_ACCESS_KEY=
KLING_SECRET_KEY=
# Optional — overrides Kling's API base URL (e.g. for a regional endpoint) if yours differs.
KLING_API_BASE=


# --- Carousel slide images (dashboard/src/lib/carouselTemplateRenderer.ts, api/pexels-search.ts) --
# Every carousel slide (the "צור תמונות לקרוסלה" button on carousel-format queue cards) is rendered
# by a deterministic, 100%-programmatic canvas template modeled on ice.co.il's real Instagram layout
# — NOT an AI image model (Pollinations/Replicate/PostNitro/Predis/Google Imagen were all tried and
# removed in earlier iterations; see git history / prior session notes for why). The background
# PHOTO layer is real, sourced from Pexels — one photo per generated carousel (not per slide, for a
# cohesive look), covered by a heavy dark gradient that guarantees full contrast for the Hebrew text.
#
# PEXELS_API_KEY — optional. https://www.pexels.com/api/ (free). Powers dynamic, topic-matched photo
# search (cybersecurity/AI/network/finance queries depending on the slide's topic). Without it,
# api/pexels-search.ts returns 503 and the dashboard falls back to a curated pool of ~8 verified,
# brand-appropriate dark/cinematic Pexels photos hardcoded in carouselTemplateRenderer.ts (real,
# hotlinkable CDN URLs — no key needed to fetch an already-known Pexels photo, only to search) — the
# feature works instantly either way, this key only adds topic-relevant variety on top.
PEXELS_API_KEY=


# --- Dashboard app (dashboard/.env — separate file, separate npm project) ------------------------
# The dashboard/ app has its OWN .env file (dashboard/.env.local), not this one. It needs the same
# 7 VITE_FIREBASE_* keys above (same Firebase project), plus, for the Social Agent tab specifically:
#   VITE_ADMIN_API_SECRET=<same value as ADMIN_API_SECRET above>
#   VITE_AGENT_API_BASE=<optional — defaults to https://mrdaniel.co.il/api/agent-generate>


# --- OpenHiggsfield AI media generation (src/agent/OpenHiggsfieldEngine.ts, api/openhiggsfield.ts) -
# 38 image/video models (Soul, Seedance, Kling 3, Wan, Flux, LTX, MiniMax, PixVerse, Grok, Qwen,
# Recraft, Ideogram …) behind one prompt — the visual layer for carousels, stories and reels, and
# Hermes's higgsfield_* tools. This is NOT the same thing as the VideoGenerationEngine providers
# above: those are five separate vendor APIs, this is one queue API in front of the whole catalog.
# The studio itself (https://github.com/wide-trace/open-higgsfield) is cloned to vendor/ for
# reference and the 38-model catalog is vendored into src/agent/openhiggsfield/ — nothing needs
# that Next app to be running. See docs/openhiggsfield-bridge.md.
#
# HF_API_BASE_URL — origin of the generation platform's queue API. The upstream repo ships this
# blank and never names the vendor; the wire contract (`Authorization: Key <id>:<secret>`,
# POST /{model}, GET /requests/{id}/status, model paths like `higgsfield-ai/soul/v2/standard`,
# `bytedance/seedance-2.0/fast`) is fal.ai's queue API — https://queue.fal.run. Confirm that
# against whoever issued your key before relying on it; any origin speaking the same contract works.
HF_API_BASE_URL=

# HF_API_KEY — your platform key, in `id:secret` form (fal.ai: https://fal.ai/dashboard/keys). A key
# without the colon is reported as missing rather than sent, since the auth header needs both halves.
# Every run is billable on the platform, which is why these actions sit behind ADMIN_API_SECRET.
HF_API_KEY=

# HIGGSFIELD_ENABLED — the kill switch, and the current state of this integration. UNSET means
# PAUSED: higgsfield-generate answers 503 code:paused and submits nothing, so no paid media call can
# happen by accident. Set it to 1 (or true/on) to re-arm. Paused deliberately on 2026-09-20 while the
# platform origin is unresolved. The carousel pipeline is unaffected either way — News/Thread/
# Comparison decks are Gemini text plus our own Figma layout and never call this bridge; a test
# enforces that.
HIGGSFIELD_ENABLED=

# There is no separate api/ function for this: api/ holds exactly 12 files and Vercel Hobby caps a
# deployment at 12, so it folds into /api/agent-generate as the actions higgsfield-models,
# higgsfield-model, higgsfield-generate and higgsfield-status — all behind ADMIN_API_SECRET. Hermes
# calls them through mcp-server/src/openhiggsfield.js (set SITE_ORIGIN in mcp-server/.env to aim it
# at a local dev server); the platform key is never read on that machine.

# Server service USER for RTDB (see getServerDb in src/agent/firebaseServer.ts). Must be listed
# under admins/<uid> in the database, or the locked rules refuse it. Unset = anonymous client.
FIREBASE_SERVER_EMAIL=
FIREBASE_SERVER_PASSWORD=
