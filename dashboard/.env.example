VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- Social Agent tab (src/components/AgentControlPanel.tsx) ------------------------------------
# Must match ADMIN_API_SECRET set on the main site's Vercel project exactly — sent as the
# x-admin-secret header on every call to /api/agent-generate. Leave unset only if the main site
# also left ADMIN_API_SECRET unset (see the main site's .env.example for why that's fail-open).
VITE_ADMIN_API_SECRET=

# Optional — which /api/agent-generate to call. Defaults to the production site
# (https://mrdaniel.co.il/api/agent-generate) since this dashboard is a live-ops tool by design.
# Point this at http://localhost:3000/api/agent-generate instead if you're running the main site's
# `npm run dev` (server.ts) locally and want to test against that.
VITE_AGENT_API_BASE=

# Optional — the production site origin the dashboard round-trip-probes every 5s (GET /api/health)
# for its live connection indicator. Defaults to https://mrdaniel.co.il. Point at
# http://localhost:3000 when running the main site's `npm run dev` locally.
VITE_SITE_ORIGIN=

# Who may open the dashboard: comma-separated emails and/or Firebase uids. Visitors can create
# accounts in this Firebase project (free-guide sign-in), so a session alone is NOT enough.
# Unset = fallback: only email/password accounts created before 2026-09-24.
VITE_DASHBOARD_ADMINS=
